{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "POSTGRES_URL",
        "POSTGRES_URL_PROD",
        "AUTH_SECRET",
        "AUTH_URL",
        "FRONTEND_URL",
        "PUBLIC_BASE_URL",
        "OPENAI_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "FIRECRAWL_API_KEY",
        "FIRECRAWL_API_ENDPOINT",
        "TAVILY_API_KEYS",
        "TURNSTILE_SECRET_KEY",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRO_PRICE_ID",
        "STRIPE_PRO_MONTHLY_PRICE_ID",
        "STRIPE_PRO_QUARTERLY_PRICE_ID",
        "STRIPE_PRO_YEARLY_PRICE_ID",
        "STRIPE_ULTIMATE_PRICE_ID",
        "STRIPE_ULTIMATE_MONTHLY_PRICE_ID",
        "STRIPE_ULTIMATE_QUARTERLY_PRICE_ID",
        "STRIPE_ULTIMATE_YEARLY_PRICE_ID",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "R2_PUBLIC_URL",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_FROM_NAME",
        "FREE_USER_MESSAGE_LIMIT",
        "PRO_MONTHLY_USER_MESSAGE_LIMIT",
        "PRO_QUARTERLY_USER_MESSAGE_LIMIT",
        "PRO_YEARLY_USER_MESSAGE_LIMIT",
        "ULTIMATE_MONTHLY_USER_MESSAGE_LIMIT",
        "ULTIMATE_QUARTERLY_USER_MESSAGE_LIMIT",
        "ULTIMATE_YEARLY_USER_MESSAGE_LIMIT",
        "ZERION_DEV_API_KEY",
        "BIRDEYE_API_KEY",
        "HELIUS_API_KEY",
        "BLOCKVISION_API_KEY",
        "ETHERSCAN_API_KEY",
        "BASE_SCAN_API_KEY",
        "BASE_SCAN_API_BASE_URL",
        "BLOCKSCOUT_API_KEY",
        "NOVES_API_KEY",
        "SEITRACE_API_KEY",
        "APTOS_API_KEY",
        "NEWS_API_KEY",
        "X_API_KEY",
        "X_API_SECRET_KEY",
        "X_ACCESS_TOKEN",
        "X_ACCESS_TOKEN_SECRET",
        "OPENROUTER_API_KEY",
        "NEXT_PUBLIC_X402_RECEIVER_ADDRESS",
        "NEXT_PUBLIC_API_URL",
        "CRONOS_TESTNET_RPC_URL",
        "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
        "INTERNAL_API_SECRET"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    }
  }
}