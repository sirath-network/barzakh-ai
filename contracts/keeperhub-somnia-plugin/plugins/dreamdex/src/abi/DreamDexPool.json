[
  {
    "type": "function",
    "name": "placeOrder",
    "inputs": [
      { "name": "side", "type": "uint8" },
      { "name": "amount", "type": "uint256" },
      { "name": "maxSlippage", "type": "uint256" }
    ],
    "outputs": [{ "name": "orderId", "type": "bytes32" }],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "mintTokens",
    "inputs": [{ "name": "collateralAmount", "type": "uint256" }],
    "outputs": [{ "name": "setsMinted", "type": "uint256" }],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "redeemWinningTokens",
    "inputs": [{ "name": "account", "type": "address" }],
    "outputs": [{ "name": "payoutAmount", "type": "uint256" }],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "closePosition",
    "inputs": [
      { "name": "side", "type": "uint8" },
      { "name": "contractsToSell", "type": "uint256" },
      { "name": "minPayout", "type": "uint256" }
    ],
    "outputs": [{ "name": "payoutReceived", "type": "uint256" }],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "cancelOrder",
    "inputs": [{ "name": "orderId", "type": "bytes32" }],
    "outputs": [{ "name": "success", "type": "bool" }],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "getMarketStatus",
    "inputs": [],
    "outputs": [
      { "name": "status", "type": "uint8" },
      { "name": "strikePrice", "type": "uint256" },
      { "name": "expiryTimestamp", "type": "uint256" }
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "getImpliedProbability",
    "inputs": [],
    "outputs": [
      { "name": "upProb", "type": "uint256" },
      { "name": "downProb", "type": "uint256" }
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "balanceOf",
    "inputs": [
      { "name": "account", "type": "address" },
      { "name": "id", "type": "uint256" }
    ],
    "outputs": [{ "name": "balance", "type": "uint256" }],
    "stateMutability": "view"
  },
  {
    "type": "event",
    "name": "MarketResolved",
    "inputs": [
      { "name": "pool", "type": "address", "indexed": true },
      { "name": "winningOutcome", "type": "uint8", "indexed": false },
      { "name": "settlementPrice", "type": "uint256", "indexed": false },
      { "name": "resolvedAt", "type": "uint256", "indexed": false }
    ]
  },
  {
    "type": "event",
    "name": "OrderPlaced",
    "inputs": [
      { "name": "orderId", "type": "bytes32", "indexed": true },
      { "name": "trader", "type": "address", "indexed": true },
      { "name": "side", "type": "uint8", "indexed": false },
      { "name": "amount", "type": "uint256", "indexed": false }
    ]
  }
]
