# Sui embedded agent defaults (server-only; do NOT prefix with NEXT_PUBLIC_)
SUI_AGENT_NETWORK=testnet
SUI_AGENT_ENABLE_MAINNET_WRITES=false

# Sui Native Bridge executor allowlists (server-only; legacy fallback, prefer Wormhole for new bridge flows)
SUI_BRIDGE_ETHEREUM_CONTRACT_SEPOLIA=0xAE68F87938439afEEDd6552B0E83D2CbC2473623
SUI_BRIDGE_ETHEREUM_CONTRACT_MAINNET=0xda3bD1fE1973470312db04551B65f401Bc8a92fD
SUI_BRIDGE_DESTINATION_CHAIN_ID=1
SUI_BRIDGE_ENABLE_MAINNET_WRITES=false
# Native Sui Bridge USDC is testnet-only in the live bridge object I checked.
# Sepolia token address must match SuiBridge.config().tokenAddressOf(3), not Circle CCTP Sepolia USDC.
# Mainnet Sui Native Bridge currently exposes ETH/USDT/BTC/WLBTC, not USDC; keep mainnet blank so execution blocks safely.
SUI_BRIDGE_USDC_TOKEN_ID=3
SUI_BRIDGE_USDC_SEPOLIA_TOKEN_ADDRESS=0x8140EBa492e02Dbf137080E2E4eC0Bd3e10784a0
SUI_BRIDGE_USDC_MAINNET_TOKEN_ADDRESS=


# Walrus Protocol endpoints (server-only)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# OpenRouter (new primary AI provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://chat.barzakh.tech
OPENROUTER_APP_TITLE=Barzakh AI

